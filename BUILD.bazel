load("@brando//:version.bzl", BRANDO_VERSION = "VERSION")
load("@brando//pkg:defs.bzl", "brand_package", "brand_publish_plan")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")

package(default_visibility = ["//visibility:public"])

exports_files(["requirements.txt"])

# Canonical layered SVGs (every tomato variant). v1 = friendly round tomato;
# v2 = the angular/geometric redesign (lowpoly / flat / mark).
filegroup(
    name = "svgs",
    srcs = [
        "//gen:tomato_svgs",
        "//gen:tomato_v2_svgs",
    ],
)

# Org-avatar raster set (PNG, both sizes, every variant; v1 + v2).
filegroup(
    name = "icons",
    srcs = [
        "//icons:tomato_icons",
        "//icons:tomato_v2_icons",
    ],
)

# Everything: vectors + icons.
filegroup(
    name = "all",
    srcs = [
        ":icons",
        ":svgs",
    ],
)

# `bazel build //:assets` -> bazel-bin/tbzl-brand-assets.zip: the tomato marks
# (SVG) + org-avatar rasters (PNG), staged for publishing to the static.tbzl.dev
# brand CDN (tomato-bazel/brand CI syncs the unzipped tree). Mirrors aion/brand's
# //:assets.
pkg_files(
    name = "_mark_files",
    srcs = ["//gen:tomato_svgs", "//gen:tomato_v2_svgs"],
    prefix = "mark",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "_icon_files",
    srcs = ["//icons:tomato_icons", "//icons:tomato_v2_icons"],
    prefix = "icon",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "_doc_files",
    srcs = ["README.md"],
    strip_prefix = strip_prefix.files_only(),
)

pkg_zip(
    name = "assets",
    srcs = [
        ":_doc_files",
        ":_icon_files",
        ":_mark_files",
    ],
    package_file_name = "tbzl-brand-assets.zip",
)

# ── the .brando package ──────────────────────────────────────────────────────
#
# `//:assets` above stages a zip for the CDN, and that zip is a BAG OF FILES: a
# consumer can extract it but cannot ask it for "the favicon" without already
# knowing what tomato calls that. It is also one of two such bundles in the fleet
# assembled by hand, with a different layout and naming convention from the other.
#
# A .brando carries a protoc-validated manifest, so every artifact has a logical
# name, a kind and a hash. `rules_brand` turns that into targets, which is what
# lets tbzl-site and the dev docs wear this brand without becoming brand
# pipelines. `//:assets` stays for the existing CDN sync.
brand_package(
    name = "tomato_package",
    assets = {
        "theme.binpb": {
            "kind": "ARTIFACT_KIND_THEME_BINPB",
            "label": "//skins:tomato_binpb",
        },
        "theme.json": {
            "kind": "ARTIFACT_KIND_THEME_JSON",
            "label": "//skins:tomato_json",
        },
        # The composed v2 mark is tomato's mark: v2 is the current identity and
        # v1 is kept for the surfaces that have not moved. A consumer asking for
        # "the mark" should get the one in use.
        "mark.svg": {
            "kind": "ARTIFACT_KIND_MARK_SVG",
            "label": "//gen:tomato_v2_mark_transparent.svg",
            "variant": "mark_transparent",
        },
        "mark-inkbg.svg": {
            "kind": "ARTIFACT_KIND_MARK_SVG",
            "label": "//gen:tomato_v2_mark_inkbg.svg",
            "variant": "mark_inkbg",
        },
        "icon-512.png": {
            "kind": "ARTIFACT_KIND_MARK_PNG",
            "label": "//icons:tomato_v2_mark_inkbg_512.png",
            "size_px": 512,
        },
        "icon-1024.png": {
            "kind": "ARTIFACT_KIND_MARK_PNG",
            "label": "//icons:tomato_v2_mark_inkbg_1024.png",
            "size_px": 1024,
        },
    },
    brando_version = BRANDO_VERSION,
    source_repo = "tomato-bazel/brand",
    spec = "tomato.textproto",
)

# Published as a GitHub Release asset on this repo, not to a CDN bucket. A
# release needs no infrastructure and sits on the repo that owns the brand; the
# `integrity` in the generated snippet is what makes the URL mean one thing,
# since a release asset can be replaced.
brand_publish_plan(
    name = "tomato_publish",
    base_url = "https://github.com/tomato-bazel/brand/releases/download/v0.1.0",
    prefix = "",
    brand = "tomato",
    package = ":tomato_package",
    version = BRANDO_VERSION,
)
