load("@brando//:defs.bzl", "brand_svgs")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@tomato_pip//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

# ---- v2: the ANGULAR / GEOMETRIC redesign (lowpoly / flat / mark) ------------
py_library(
    name = "gen_tomato_v2_lib",
    srcs = ["gen_tomato_v2.py"],
    imports = ["."],
    deps = [
        "@brando//marklib",
        requirement("shapely"),
    ],
)

py_binary(
    name = "gen_tomato_v2",
    srcs = ["gen_tomato_v2.py"],
    imports = ["."],
    deps = [
        "@brando//marklib",
        requirement("shapely"),
    ],
)

py_binary(
    name = "raster_tomato_v2",
    srcs = ["raster_tomato_v2.py"],
    imports = ["."],
    deps = [
        ":gen_tomato_v2_lib",
        "@brando//marklib:raster",
        requirement("pillow"),
    ],
)

# The tomato-bazel mark construction (shapely CSG). EMISSION goes through
# @brando//marklib (the reusable layered-SVG / composite convention).
py_library(
    name = "gen_tomato_lib",
    srcs = ["gen_tomato.py"],
    imports = ["."],
    deps = [
        "@brando//marklib",
        requirement("shapely"),
    ],
)

py_binary(
    name = "gen_tomato",
    srcs = ["gen_tomato.py"],
    imports = ["."],
    deps = [
        "@brando//marklib",
        requirement("shapely"),
    ],
)

# Hermetic tomato rasterizer (brando's Pillow helpers; supersampled PNGs).
py_binary(
    name = "raster_tomato",
    srcs = ["raster_tomato.py"],
    imports = ["."],
    deps = [
        ":gen_tomato_lib",
        "@brando//marklib:raster",
        requirement("pillow"),
    ],
)

# tomato-bazel layered SVGs. These lists are now the ONLY copy: brand_svgs
# computes the outs from them AND passes them to the generator as
# --variant/--layer, so gen_tomato.py no longer needs its own VARIANTS/LAYERS
# constants for a human to mirror here. The "keep these lists in sync" comment
# that used to sit on this block is gone with the second list.
#
# A background layer only exists for the variants that HAVE a background, which
# is real structure rather than an exception to paper over -- so `transparent`
# gets no bg.svg, stated once in extra_outs.
_TOMATO_BG_VARIANTS = [
    "inkbg",
    "inkbg_flat",
    "whitebg",
]

_TOMATO_LAYERS = [
    "svg",
    "body.svg",
    "calyx.svg",
]

brand_svgs(
    name = "tomato_svgs",
    extra_outs = ["tomato_%s.bg.svg" % v for v in _TOMATO_BG_VARIANTS],
    generator = ":gen_tomato",
    layers = _TOMATO_LAYERS,
    prefix = "tomato",
    variants = _TOMATO_BG_VARIANTS + ["transparent"],
)

# ---- v2 layered SVGs: the ANGULAR redesign. Each style emits a different set of
# tone layers (the low-poly look groups facets/blades into base/dark/light), so
# the per-style layer lists are explicit. Keep in sync with gen_tomato_v2.py.
_V2_LAYERS = {
    "lowpoly": ["body_base", "body_dark", "body_light", "calyx_base", "calyx_dark", "calyx_light"],
    "flat": ["body_base", "calyx_base"],
    "mark": ["body_dark", "body_light", "calyx_base", "calyx_dark", "calyx_light"],
}

# composite + per-tone layer SVGs (every style x ink/transparent) ...
_V2_SVG_OUTS = [
    "tomato_v2_%s_%s.%s.svg" % (style, bg, lyr)
    for style in _V2_LAYERS
    for bg in ("inkbg", "transparent")
    for lyr in _V2_LAYERS[style]
] + [
    "tomato_v2_%s_%s.svg" % (style, bg)
    for style in _V2_LAYERS
    for bg in ("inkbg", "transparent")
] + [
    # ... plus the rounded-square bg layer only for the ink variants.
    "tomato_v2_%s_inkbg.bg.svg" % style
    for style in _V2_LAYERS
]

brand_svgs(
    name = "tomato_v2_svgs",
    generator = ":gen_tomato_v2",
    outs = _V2_SVG_OUTS,
)
